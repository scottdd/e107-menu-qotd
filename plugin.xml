<?xml version="1.0" encoding="utf-8"?>
<e107Plugin name="Quote of the Day" lan="LAN_PLUGIN_QOTD_NAME" version="2.6.2" date="2026-10-26" compatibility="2.0" installRequired="true">
	<author name="cameron / Scott Dowlen" url="https://github.com/scottdd/e107-menu-qotd" />
	<summary lan="LAN_PLUGIN_QOTD_SUMMARY">Quote of the Day widget with structured attributions, topical tags, pinned date ranges, daily or random rotation, and GitHub collection sync.</summary>
	<description lan="LAN_PLUGIN_QOTD_DESC">Displays a daily or random quote with structured attribution, source context, theme-inheriting tag pills, pinned quote date ranges, an interactive AJAX "Another Quote" button, and dual-format JSON/fortune synchronization with scottdd/qotd-collections. Imagined by human, built with AI.</description>
	<category>menu</category>
	<keywords>
		<word>quote</word>
		<word>qotd</word>
		<word>fortune</word>
		<word>wisdom</word>
	</keywords>
	<adminLinks>
		<link url="admin_config.php" description="Configure Quote of the Day" icon="images/icon_32.png" iconSmall="images/icon_16.png" icon128="images/icon_128.png" primary="true">LAN_CONFIGURE</link>
	</adminLinks>
	<mainPrefs>
		<pref name="qotd_header">Quote of the Day</pref>
		<pref name="qotd_source_mode">db</pref>
		<pref name="qotd_rotation_mode">daily</pref>
		<pref name="qotd_collections">default</pref>
		<pref name="qotd_file">quotes/default.json</pref>
		<pref name="qotd_show_tags">1</pref>
		<pref name="qotd_show_source">1</pref>
		<pref name="qotd_show_next_btn">1</pref>
		<pref name="qotd_rendertype">0</pref>
		<pref name="qotd_github_repo">scottdd/qotd-collections</pref>
		<pref name="qotd_github_branch">main</pref>
	</mainPrefs>
</e107Plugin>
